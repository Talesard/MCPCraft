* text=auto

# Windows scripts keep CRLF so they run in Windows PowerShell 5.1
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Everything else stays LF in the working tree
*.java text eol=lf
*.gradle text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.jar binary
*.zip binary
